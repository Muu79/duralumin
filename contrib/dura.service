[Unit]
Description=Duralumin podcast download daemon
Documentation=https://github.com/Muu79/dura
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dura
Group=dura

# Point at whichever config file you use
Environment=DURALUMIN_CONFIG=/etc/dura/config.toml

ExecStart=/usr/bin/dura start
# Reload triggers a restart so the new config is picked up on next start.
# (Hot-reload without restart is not supported in v0.1.)
ExecReload=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=30s

# Keep logs going to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dura

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# If your config uses a storage.dir or library_path outside these defaults,
# add those paths here (space-separated) or override via a drop-in unit.
ReadWritePaths=/var/lib/dura /etc/dura

[Install]
WantedBy=multi-user.target
