#!/bin/bash
set -e

case "$1" in
    remove|upgrade|deconfigure)
        if [ -d /run/systemd/system ]; then
            if systemctl is-active --quiet dura 2>/dev/null; then
                systemctl stop dura
            fi
            if systemctl is-enabled --quiet dura 2>/dev/null; then
                systemctl disable dura
            fi
        fi
        ;;
esac
