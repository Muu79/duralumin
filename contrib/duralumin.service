[Unit]
Description=Duralumin podcast download daemon
Documentation=https://github.com/Muu79/duralumin
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=duralumin
Group=duralumin

# Point at whichever config file you use
Environment=DURALUMIN_CONFIG=/etc/duralumin/config.toml

ExecStart=/usr/local/bin/duralumin run
Restart=on-failure
RestartSec=30s

# Keep logs going to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=duralumin

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/duralumin /etc/duralumin

[Install]
WantedBy=multi-user.target
